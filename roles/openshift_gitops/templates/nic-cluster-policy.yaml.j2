# https://docs.redhat.com/en/documentation/openshift_container_platform/4.18/html/hardware_accelerators/rdma-remote-direct-memory-access#rdma-configuring-the-nvidia-network-operator_rdma-remote-direct-memory-access
# https://docs.nvidia.com/networking/display/kubernetes2570/getting-started-openshift.html#network-operator-installation-using-openshift-oc-cli
{% set _nno = openshift.operators.nvidia_network_operator | default({}) %}
{# DOCA Version Mapping - Maps Network Operator versions to DOCA driver and telemetry versions #}
{% set _doca_versions = {
  '25.10': {'driver': 'doca3.2.0-25.10-1.2.8.0-2', 'telemetry': '1.23.4-doca3.2.0-host'},
  '26.1': {'driver': 'doca3.3.0-26.01-1.0.0.0-0', 'telemetry': '1.23.4-doca3.2.0-host'},
  '26.4': {'driver': 'doca3.4.0-26.04-0.8.6.0-0', 'telemetry': '1.25.5-doca3.4.0-host'},
  '26.7': {'driver': 'doca3.4.0-26.04-0.8.6.0-0', 'telemetry': '1.25.5-doca3.4.0-host'}
} %}
{% set _nno_version = _nno.get('network_operator_version', 'v26.4.0') %}
{# Extract major.minor version (e.g., '25.10' from 'v25.10.0' or 'v25.10.1') #}
{% set _version_match = _nno_version | regex_search('^v([0-9]+\.[0-9]+)') %}
{% set _version_key = _version_match.group(1) if _version_match else '26.4' %}
{% set _doca_config = _doca_versions.get(_version_key, _doca_versions['26.4']) %}
{% set _intfs = _nno.get('mac_vlan', [
  {'master_interface': 'ens201f0np0'},
  {'master_interface': 'ens202f0np0'},
  {'master_interface': 'ens203f0np0'},
  {'master_interface': 'ens204f0np0'},
  {'master_interface': 'ens205f0np0'},
  {'master_interface': 'ens206f0np0'},
  {'master_interface': 'ens207f0np0'},
  {'master_interface': 'ens208f0np0'}
]) %}

---
apiVersion: mellanox.com/v1alpha1
kind: NicClusterPolicy
metadata:
  annotations:
    argocd.argoproj.io/sync-options: SkipDryRunOnMissingResource=true
    argocd.argoproj.io/sync-wave: "10" # Ensures this is applied AFTER the operator is ready
  name: nic-cluster-policy
spec:
  docaTelemetryService:
    image: doca_telemetry
    repository: nvcr.io/nvidia/doca
    version: {{ _doca_config.telemetry }}
  ofedDriver:
    env:
      - name: CREATE_IFNAMES_UDEV
        value: "true"
      # - name: ENTRYPOINT_DEBUG
      #   value: 'true'
      - name: RESTORE_DRIVER_ON_POD_TERMINATION
        value: 'true'
      - name: UNLOAD_STORAGE_MODULES
        value: 'true'
    image: doca-driver
    repository: nvcr.io/nvidia/mellanox
    version: {{ _doca_config.driver }}
    startupProbe:
      initialDelaySeconds: 10
      periodSeconds: 20
    livenessProbe:
      initialDelaySeconds: 30
      periodSeconds: 30
    readinessProbe:
      initialDelaySeconds: 10
      periodSeconds: 30
    upgradePolicy:
      autoUpgrade: true
      drain:
        deleteEmptyDir: true
        enable: true
        force: true
        podSelector: ''
        timeoutSeconds: 300
      maxParallelUpgrades: 1
      safeLoad: false
  rdmaSharedDevicePlugin:
    config: |
      {
        "configList": [
          {
            "resourceName": "rdmashared",
            "rdmaHcaMax": 1000,
            "selectors": {
              "ifNames": [
{% for intf in _intfs %}
                "{{ intf.master_interface }}"{{ "," if not loop.last else "" }}
{% endfor %}
              ]
            }
          }
        ]
      }
    image: k8s-rdma-shared-dev-plugin
    repository: nvcr.io/nvidia/mellanox
    version: network-operator-{{ _nno.network_operator_version | default('v26.4.0') }}
