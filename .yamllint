---
extends: default
ignore: |
  .ansible/**
  .git/**
  assisted-installer/**
  host_vars/**
  netapp/**
  roles/openshift_gitops/helm/**/templates/**/*.yaml
rules:
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  line-length:
    max: 220
    level: error
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
